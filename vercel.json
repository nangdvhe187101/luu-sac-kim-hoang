{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/loc-do/(.*)",
      "headers": {
        "Content-Disposition": "attachment; filename=\"$1\"",
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    }
  ]
}

