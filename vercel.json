{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/3d", "destination": "/vi/visit/3d", "permanent": false },
    { "source": "/3d-tour", "destination": "/vi/visit/3d", "permanent": false },
    { "source": "/trien-lam-3d/threejs-museum.html", "destination": "/trien-lam-3d/threejs-3d-room.html", "permanent": true },
    { "source": "/gioi-thieu", "destination": "/vi/introduction", "permanent": false },
    { "source": "/nghe-nhan", "destination": "/vi/introduction/nghe-nhan", "permanent": false },
    { "source": "/doi-tac", "destination": "/vi/introduction/doi-tac", "permanent": false },
    { "source": "/nha-tai-tro", "destination": "/vi/introduction/doi-tac/nha-tai-tro", "permanent": false },
    { "source": "/bao-tro-truyen-thong", "destination": "/vi/introduction/doi-tac/bao-tro-truyen-thong", "permanent": false },
    { "source": "/tham-quan", "destination": "/vi/visit", "permanent": false },
    { "source": "/tranh", "destination": "/vi/visit/tranh", "permanent": false },
    { "source": "/hanh-trinh", "destination": "/vi/visit/hanh-trinh", "permanent": false },
    { "source": "/san-pham-sang-tao", "destination": "/vi/services", "permanent": false },
    { "source": "/san-pham", "destination": "/vi/services", "permanent": false },
    { "source": "/qua-tang", "destination": "/vi/services/souvenirs", "permanent": false },
    { "source": "/qua-tang-luu-niem", "destination": "/vi/services/souvenirs", "permanent": false },
    { "source": "/su-kien", "destination": "/vi/events", "permanent": false },
    { "source": "/events", "destination": "/vi/events", "permanent": false },
    { "source": "/tin-tuc", "destination": "/vi/posts", "permanent": false },
    { "source": "/news", "destination": "/vi/posts", "permanent": false },
    { "source": "/tim-kiem", "destination": "/vi/search", "permanent": false }
  ],
  "rewrites": [
    { "source": "/vi", "destination": "/index.html" },
    { "source": "/vi/", "destination": "/index.html" },
    { "source": "/vi/news", "destination": "/vi/posts/index.html" },
    { "source": "/vi/creative-products", "destination": "/vi/services/souvenirs/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|webp|png|jpg|jpeg|svg|woff|woff2|ttf|otf|mp3|mp4|glb)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/trien-lam-3d/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/trien-lam-3d/(.*)\\.glb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
